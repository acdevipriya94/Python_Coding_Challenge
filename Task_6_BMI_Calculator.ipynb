      ],
      "source": [
        "weight = int(input(\"Enter weight in (kg) : \"))\n",
        "height = int(input(\"Enter Height in (m) : \"))\n",
        "bmi = weight / (height * height)\n",
        "if bmi < 18.5:\n",
        "  print(\"Underweight\")\n",
        "elif bmi < 25:\n",
        "  print(\"Normal\")\n",
        "elif bmi < 30:\n",
        "  print(\"Overweight\")\n",
        "else:\n",
        "  print(\"Obese\")"
      ]
    }
  ]
}